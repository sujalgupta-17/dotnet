using System;
using System.Drawing;
using System.Web.UI;

namespace EmployeeRegistration
{
    public partial class EmployeeRegistration : System.Web.UI.Page
    {
        protected void Page_Load(object sender, EventArgs e)
        {
        }

        protected void btnSubmit_Click(object sender, EventArgs e)
        {
            if (Page.IsValid)
            {
                lblOutput.ForeColor = Color.Green;
                lblOutput.Text = "Employee Registration Successful!<br />" +
                                 "Name: " + txtName.Text + "<br />" +
                                 "Email: " + txtEmail.Text + "<br />" +
                                 "Age: " + txtAge.Text;
            }
            else
            {
                lblOutput.ForeColor = Color.Red;
                lblOutput.Text = "Please fix validation errors before submitting.";
            }
        }
    }
}
