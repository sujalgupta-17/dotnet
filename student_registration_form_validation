FILE 2: EmployeeRegistration.aspx
Path: EmployeeRegistration/EmployeeRegistration.aspx
--------------------------------------------------------------------------------
<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="EmployeeRegistration.aspx.cs" Inherits="EmployeeRegistration.EmployeeRegistration" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Employee Registration Form</title>
</head>
<body style="padding: 20px; font-family: Arial, sans-serif;">
    <form id="form1" runat="server">
        <h2>Employee Registration Form</h2>

        <!-- 1. RequiredFieldValidator: Name -->
        <asp:Label ID="lblName" runat="server" Text="Employee Name:"></asp:Label><br />
        <asp:TextBox ID="txtName" runat="server"></asp:TextBox>
        <asp:RequiredFieldValidator 
            ID="rfvName" 
            runat="server" 
            ControlToValidate="txtName" 
            ErrorMessage="Name is required!" 
            ForeColor="Red">
        </asp:RequiredFieldValidator>
        <br /><br />

        <!-- 2. RegularExpressionValidator: Email ID -->
        <asp:Label ID="lblEmail" runat="server" Text="Email ID:"></asp:Label><br />
        <asp:TextBox ID="txtEmail" runat="server"></asp:TextBox>
        <asp:RequiredFieldValidator 
            ID="rfvEmail" 
            runat="server" 
            ControlToValidate="txtEmail" 
            ErrorMessage="Email is required!" 
            ForeColor="Red">
        </asp:RequiredFieldValidator>
        <asp:RegularExpressionValidator 
            ID="revEmail" 
            runat="server" 
            ControlToValidate="txtEmail" 
            ValidationExpression="\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*" 
            ErrorMessage="Invalid email format!" 
            ForeColor="Red">
        </asp:RegularExpressionValidator>
        <br /><br />

        <!-- 3. RangeValidator: Age -->
        <asp:Label ID="lblAge" runat="server" Text="Age (21 to 60):"></asp:Label><br />
        <asp:TextBox ID="txtAge" runat="server"></asp:TextBox>
        <asp:RequiredFieldValidator 
            ID="rfvAge" 
            runat="server" 
            ControlToValidate="txtAge" 
            ErrorMessage="Age is required!" 
            ForeColor="Red">
        </asp:RequiredFieldValidator>
        <asp:RangeValidator 
            ID="rvAge" 
            runat="server" 
            ControlToValidate="txtAge" 
            MinimumValue="21" 
            MaximumValue="60" 
            Type="Integer" 
            ErrorMessage="Age must be between 21 and 60!" 
            ForeColor="Red">
        </asp:RangeValidator>
        <br /><br />

        <!-- 4. CompareValidator: Password and Confirm Password -->
        <asp:Label ID="lblPass" runat="server" Text="Password:"></asp:Label><br />
        <asp:TextBox ID="txtPass" runat="server" TextMode="Password"></asp:TextBox>
        <asp:RequiredFieldValidator 
            ID="rfvPass" 
            runat="server" 
            ControlToValidate="txtPass" 
            ErrorMessage="Password is required!" 
            ForeColor="Red">
        </asp:RequiredFieldValidator>
        <br /><br />

        <asp:Label ID="lblConfirmPass" runat="server" Text="Confirm Password:"></asp:Label><br />
        <asp:TextBox ID="txtConfirmPass" runat="server" TextMode="Password"></asp:TextBox>
        <asp:RequiredFieldValidator 
            ID="rfvConfirmPass" 
            runat="server" 
            ControlToValidate="txtConfirmPass" 
            ErrorMessage="Confirm Password is required!" 
            ForeColor="Red">
        </asp:RequiredFieldValidator>
        <asp:CompareValidator 
            ID="cvPass" 
            runat="server" 
            ControlToValidate="txtConfirmPass" 
            ControlToCompare="txtPass" 
            ErrorMessage="Passwords do not match!" 
            ForeColor="Red">
        </asp:CompareValidator>
        <br /><br />

        <!-- Submit Button -->
        <asp:Button ID="btnSubmit" runat="server" Text="Register" OnClick="btnSubmit_Click" />
        <br /><br />

        <!-- Output Label -->
        <asp:Label ID="lblOutput" runat="server" Font-Bold="True"></asp:Label>
    </form>
</body>
</html>


