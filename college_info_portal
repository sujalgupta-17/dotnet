FILE 5: Program.cs
Path: CollegePortalPWA/Program.cs
--------------------------------------------------------------------------------
var builder = WebApplication.CreateBuilder(args);

// Add services to the container.
builder.Services.AddControllersWithViews();

var app = builder.Build();

// Configure the HTTP request pipeline.
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseStaticFiles(); // CRITICAL: Allows serving manifest.json, icons, and service-worker.js

app.UseRouting();

app.UseAuthorization();

app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}");

app.Run();

================================================================================
HOW TO RUN AND VERIFY THE PWA IN BROWSER
================================================================================
1. Press F5 in Visual Studio to run the project.
2. In Google Chrome or Microsoft Edge:
   - Notice the "Install app" icon appears on the right side of the URL/address bar.
   - Click "Install" to install the College Information Portal directly to your desktop/OS.
3. Open Developer Tools (Press F12):
   - Switch to the "Console" tab: Verify you see "Service Worker Registered", "Service Worker Installed", and the URL fetch logs.
   - Switch to the "Application" tab:
     * Click "Manifest" on the left panel to verify your name, colors, and icons.
     * Click "Service workers" to verify the service worker is activated and running.
