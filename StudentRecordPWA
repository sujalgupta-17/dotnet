--------------------------------------------------------------------------------
using Microsoft.AspNetCore.Mvc;
using StudentRecordPWA.Models;
using System.Collections.Generic;

namespace StudentRecordPWA.Controllers
{
    public class StudentController : Controller
    {
        public IActionResult Index()
        {
            List<Student> students = new List<Student>()
            {
                new Student { Id = 1, Name = "Tanu", Course = "BSC IT", Age = 20 },
                new Student { Id = 2, Name = "Pooja", Course = "BSC CS", Age = 21 },
                new Student { Id = 3, Name = "Mayank", Course = "BCA", Age = 20 }
            };

            return View(students);
        }
    }
}


