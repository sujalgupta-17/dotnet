FILE 5: wwwroot/service-worker.js
--------------------------------------------------------------------------------
WHERE IT GOES:
- Right-click "wwwroot" -> Add -> New Item...
- Select JavaScript File -> name it: service-worker.js -> Click Add.

PASTE THIS CODE:
--------------------------------------------------------------------------------
const CACHE_NAME = "student-pwa-cache-v1";
const urlsToCache = [
    "/Student/Index"
];

self.addEventListener("install", event => {
    event.waitUntil(
        caches.open(CACHE_NAME)
            .then(cache => {
                return cache.addAll(urlsToCache);
            })
    );
});

self.addEventListener("fetch", event => {
    event.respondWith(
        caches.match(event.request)
            .then(response => {
                return response || fetch(event.request);
            })
    );
});


