using System;
using System.Drawing;
using System.Web;
using System.Web.UI;

namespace CookiesDemoApp
{
    public partial class Cookies_Demo : System.Web.UI.Page
    {
        // Explicit control definitions to link ASPX to C#
        protected global::System.Web.UI.WebControls.TextBox txtName;
        protected global::System.Web.UI.WebControls.Label lblOutput;
        protected global::System.Web.UI.WebControls.Button btnSave;
        protected global::System.Web.UI.WebControls.Button btnShow;

        protected void Page_Load(object sender, EventArgs e)
        {
        }

        // Save both Session Cookie and Persistent Cookie
        protected void btnSave_Click(object sender, EventArgs e)
        {
            // 1. Session Cookie (Deleted when browser closes)
            HttpCookie sessionCookie = new HttpCookie("sessionUser");
            sessionCookie.Value = txtName.Text;
            Response.Cookies.Add(sessionCookie);

            // 2. Persistent Cookie (Expires in 1 day)
            HttpCookie persistentCookie = new HttpCookie("persistentUser");
            persistentCookie.Value = txtName.Text;
            persistentCookie.Expires = DateTime.Now.AddDays(1);
            Response.Cookies.Add(persistentCookie);

            lblOutput.ForeColor = Color.Green;
            lblOutput.Text = "Cookies saved successfully!";
        }

        // Retrieve and display both Cookies
        protected void btnShow_Click(object sender, EventArgs e)
        {
            string sessionData = string.Empty;
            string persistentData = string.Empty;

            // Check Session Cookie
            if (Request.Cookies["sessionUser"] != null)
            {
                sessionData = Request.Cookies["sessionUser"].Value;
            }
            else
            {
                sessionData = "Not Found / Expired";
            }

            // Check Persistent Cookie
            if (Request.Cookies["persistentUser"] != null)
            {
                persistentData = Request.Cookies["persistentUser"].Value;
            }
            else
            {
                persistentData = "Not Found / Expired";
            }

            // Display results
            lblOutput.ForeColor = Color.Blue;
            lblOutput.Text = "Session Cookie: " + sessionData + "<br />" +
                             "Persistent Cookie: " + persistentData;
        }
    }
}
