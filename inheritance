using System;

// Single Inheritance Example
class Animal
{
    public void Eat()
    {
        Console.WriteLine("Animal eats food.");
    }
}

class Dog : Animal   // Single Inheritance (Dog inherits Animal)
{
    public void Bark()
    {
        Console.WriteLine("Dog barks.");
    }
}

// Multilevel Inheritance Example
class Vehicle
{
    public void Start()
    {
        Console.WriteLine("Vehicle starts.");
    }
}

class Car : Vehicle   // Car inherits Vehicle
{
    public void Drive()
    {
        Console.WriteLine("Car drives.");
    }
}

class SportsCar : Car   // SportsCar inherits Car (multilevel)
{
    public void Turbo()
    {
        Console.WriteLine("SportsCar uses turbo!");
    }
}

// Hierarchical Inheritance Example
class Shape
{
    public void Draw()
    {
        Console.WriteLine("Drawing a shape.");
    }
}

class Circle : Shape   // Circle inherits Shape
{
    public void Area()
    {
        Console.WriteLine("Area of Circle = πr²");
    }
}

class Rectangle : Shape   // Rectangle inherits Shape
{
    public void Area()
    {
        Console.WriteLine("Area of Rectangle = l × w");
    }
}

class Program
{
    static void Main(string[] args)
    {
        // Single Inheritance
        Console.WriteLine("=== Single Inheritance ===");
        Dog d = new Dog();
        d.Eat();
        d.Bark();

        // Multilevel Inheritance
        Console.WriteLine("\n=== Multilevel Inheritance ===");
        SportsCar sc = new SportsCar();
        sc.Start();
        sc.Drive();
        sc.Turbo();

        // Hierarchical Inheritance
        Console.WriteLine("\n=== Hierarchical Inheritance ===");
        Circle c = new Circle();
        c.Draw();
        c.Area();

        Rectangle r = new Rectangle();
        r.Draw();
        r.Area();
    }
}
